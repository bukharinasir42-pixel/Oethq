# Local development only. Copy to `.env` at the repo root:
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows)
#
# `docker/docker-compose.yml` reads this file, and it is what decides the
# username, password and database name Postgres is created with.
#
# These values are NOT arbitrary. They must match the DATABASE_URL already in
# backend/.env, which is:
#
#     postgresql://oet:oet@127.0.0.1:5432/oet_lms
#
# Compose's own defaults are oet_admin / oet_password, so without this file the
# database comes up with a user the backend does not have, and every command
# after it fails with an authentication error that does not name the cause.
POSTGRES_USER=oet
POSTGRES_PASSWORD=oet
POSTGRES_DB=oet_lms
POSTGRES_PORT=5432

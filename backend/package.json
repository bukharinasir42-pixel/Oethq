{
  "name": "oet-lms-backend",
  "version": "0.1.0",
  "description": "OET LMS API \u2014 Express HTTP server + Prisma domain services",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate --schema ./src/database/schema.prisma",
    "dev": "ts-node -r reflect-metadata -r tsconfig-paths/register src/server.ts",
    "start": "node -r reflect-metadata dist/server.js",
    "start:dev": "ts-node -r reflect-metadata -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "prisma:generate": "prisma generate --schema ./src/database/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./src/database/schema.prisma",
    "prisma:seed": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/seed.ts",
    "db:clear-tests-tasks": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/clear-tests-tasks.ts",
    "db:clear-tasks": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/clear-daily-tasks.ts",
    "db:seed-mock-demo": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/seed-mock-demo.ts",
    "db:seed-demo-accounts": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/seed-demo-accounts.ts",
    "email:test": "ts-node --transpile-only -r tsconfig-paths/register scripts/send-test-email.ts",
    "storage:ensure-minio-buckets": "ts-node --transpile-only scripts/ensure-minio-buckets.ts",
    "storage:setup-aws": "ts-node --transpile-only scripts/setup-aws-s3.ts",
    "prisma:seed-cohort-demo": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/seed-cohort-demo.ts",
    "prisma:seed-products": "ts-node --transpile-only -r tsconfig-paths/register ./src/database/seed-products.ts",
    "chat:ingest": "ts-node --transpile-only -r tsconfig-paths/register scripts/ingest-knowledge.ts",
    "paper:check": "ts-node --transpile-only -r tsconfig-paths/register scripts/check-paper.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-dynamodb": "^3.1033.0",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/lib-dynamodb": "^3.1033.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "6.19.3",
    "bcrypt": "^5.1.1",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "stripe": "^17.1.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/busboy": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "6.19.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}

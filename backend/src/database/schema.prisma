generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CANDIDATE
  STAFF
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

enum PlanTier {
  STARTER
  FOUNDATION
  ACCELERATOR
  MASTERY
  CUSTOM
}

// ---- Course catalogue / multi-product entitlements ----
// Added ALONGSIDE the existing Plan/Subscription/Purchase (Complete Course) system,
// which is left untouched. Standalone courses are Products bought via ProductPurchase
// and owned via additive Entitlements (a user can hold several at once).
enum ProductCategory {
  COMPLETE   // the existing Complete Course (Foundation/Precision/Elite) — links to existing plans
  STANDALONE // Reading & Listening, Reading, Listening
  ADDON      // Writing Corrections, Speaking Role Plays (currently coming-soon)
}

enum ProductStatus {
  ACTIVE      // has a landing page and (if isPurchasable) a checkout flow
  COMING_SOON // presentation-only, locked, never purchasable
}

enum ProductPurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EntitlementSource {
  PRODUCT_PURCHASE      // bought a standalone product
  COMPLETE_SUBSCRIPTION // derived from an active Complete Course subscription
  GRANT                 // manual/admin grant
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum Skill {
  READING
  LISTENING
  WRITING
  SPEAKING
}

enum TestType {
  LISTENING
  READING
}

enum QuestionPart {
  A
  B
  C
}

enum QuestionType {
  MCQ
  FILL_BLANK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

enum AttemptSection {
  LISTENING
  READING_PART_A
  READING_PART_BC
  COMPLETE
}

enum AssetKind {
  AUDIO
  VIDEO
  PDF
  LINK
  IMAGE
}

enum BlogType {
  READING
  SPEAKING
  WRITING
  LISTENING
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum OTPPurpose {
  REGISTER
  LOGIN
  FREE_TRIAL
  SUBSCRIPTION_ACTIVATION
  PASSWORD_RESET
}

enum BandLabel {
  CRITICAL
  AT_RISK
  DEVELOPING
  COMPETITIVE
  STRONG
  EXCELLENT
  OUTSTANDING
  ELITE
}

/// Official OET grade (for imported contentJson-driven tests). C_PLUS = "C+".
enum OetGrade {
  A
  B
  C_PLUS
  C
  D
  E
}

model User {
  id               String          @id @default(uuid())
  name             String
  email            String          @unique
  whatsapp         String?
  // Required onboarding fields (collected at sign-up).
  profession       String?
  heardFrom        String?
  // Stable per-student writing/correction ID (assigned on first Writing submission).
  writingCode      String?         @unique
  passwordHash     String
  role             Role            @default(CANDIDATE)
  emailVerifiedAt  DateTime?
  createdAt        DateTime        @default(now())
  lastLogin        DateTime?
  // Set once the student finishes the mandatory "how to use the course" intro video.
  onboardingWatchedAt DateTime?
  // Exam integrity: cumulative screenshot-attempt strikes; hard-suspend on 3rd.
  screenshotStrikes Int            @default(0)
  suspendedAt      DateTime?
  suspendedReason  String?

  subscriptions  Subscription[]
  testResults    TestResult[]
  testAttempts   TestAttempt[]
  uploadedAssets StorageObject[]
  otpCodes       OTPCode[]
  purchases      Purchase[]
  auditLogs      AuditLog[]

  productPurchases ProductPurchase[]
  entitlements     Entitlement[]

  cohortSchedule   CohortSchedule?
  cohortSessions   CohortSessionRecord[]
  cohortDays       CohortDayProgress[]
  cohortWarnings   CohortWarning[]
  cohortReports    CohortWeeklyReport[]
  cohortChatMessages CohortChatMessage[]
  sessions           UserSession[]
}

/// One signed-in device. The JWT carries this row's id, so a session can be
/// ended server-side — which a stateless bearer token could not do — and so the
/// number of devices per student can be capped.
///
/// `deviceId` is generated in the browser and kept in localStorage, so clearing
/// site data or using a private window reads as a new device. That is the
/// intended trade-off: no fingerprinting, nothing invasive, and a shared clinic
/// computer does not silently merge two students into one device.
model UserSession {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  /// Hash of stable browser traits (platform, screen, timezone, renderer...).
  /// Clearing site data mints a new deviceId; the fingerprint lets that session
  /// be RE-LINKED to the same device instead of burning a second slot — and it
  /// makes the cap meaningfully harder to sidestep with a private window.
  fingerprint String?
  /// Best-effort human label ("Chrome on Windows") for the admin device list.
  label      String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  /// Set when the session ends: signed out, evicted by the device cap, or
  /// revoked by an admin. Never deleted — the history is the sharing signal.
  revokedAt  DateTime?
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, fingerprint])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Plan {
  id             String         @id @default(uuid())
  name           String         @unique
  tier           PlanTier
  description    String?
  price          Decimal        @db.Decimal(10, 2)
  currency       String         @default("USD")
  readingLimit   Int
  listeningLimit Int
  pastPaperLimit Int
  // Writing correction allowance granted by this plan tier (admin-editable).
  writingLimit   Int            @default(0)
  durationDays   Int            @default(60)
  isCustom       Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subscriptions  Subscription[]
  purchases      Purchase[]
}

model Subscription {
  id                 String              @id @default(uuid())
  userId             String
  planId             String
  status             SubscriptionStatus  @default(TRIAL)
  startDate          DateTime?
  endDate            DateTime?
  otpVerifiedAt      DateTime?
  trialUsed          Boolean             @default(false)
  welcomeEmailSentAt DateTime?
  customAccessUrl    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  plan               Plan                @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@unique([userId, planId])
}

// Authoritative course catalogue (single source of truth for dropdown / homepage
// catalogue / landing pages / checkout / entitlement mapping).
model Product {
  id               String          @id @default(uuid())
  slug             String          @unique // reading-listening, reading, listening, writing-corrections, speaking-role-plays, complete
  name             String
  category         ProductCategory
  status           ProductStatus   @default(COMING_SOON)
  displayOrder     Int             @default(0)
  shortDescription String?
  landingRoute     String?         // /courses/reading etc. (null for coming-soon or "links to existing")
  price            Decimal?        @db.Decimal(10, 2) // configurable; null until set / for coming-soon
  currency         String          @default("USD")
  durationDays     Int?            // configurable access window
  includedSkills   String[]        // e.g. ["READING","LISTENING"]
  // Writing-correction letters this product grants (0 for non-writing products).
  writingCorrections Int           @default(0)
  includedModules  Json?           // structured inclusions (lectures/tests/mocks/pastpapers/reports)
  entitlementKey   String          @unique // stable gating key, e.g. "reading_listening"
  checkoutRef      String?         // stripe price id / internal ref (configurable)
  featured         Boolean         @default(false)
  isPurchasable    Boolean         @default(false) // HARD safeguard: coming-soon products are never purchasable
  upgradeOfSlug    String?         // upgrade relationship to another product slug
  // Single-skill course tiers (Foundation/Momentum/Precision/Mega). 0 = not a tier.
  tierRank         Int             @default(0) // 1=Foundation, 2=Momentum, 3=Precision, 4=Mega
  mockTestLimit    Int             @default(0) // mock tests this tier grants (0 = n/a)
  pastPaperLimit   Int             @default(0) // OET HQ past papers this tier grants
  caseNoteLimit    Int             @default(0) // writing case-note tasks this tier grants
  passPredictor    Boolean         @default(false) // Pass Predictor tracker unlocked at this tier
  retiredAt        DateTime?       // set when a product is retired (hidden from the public catalogue)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  purchases        ProductPurchase[]
  entitlements     Entitlement[]

  @@index([category, status])
  @@index([displayOrder])
}

// Standalone-product order. Mirrors the essentials of Purchase but never touches
// the Complete Course purchase table. Completion grants an Entitlement.
model ProductPurchase {
  id                String                @id @default(uuid())
  userId            String
  productId         String
  amount            Decimal               @db.Decimal(10, 2)
  currency          String                @default("USD")
  status            ProductPurchaseStatus @default(PENDING)
  provider          String?
  reference         String?
  checkoutSessionId String?               @unique
  receiptUrl        String?
  webhookEventId    String?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user              User                  @relation(fields: [userId], references: [id])
  product           Product               @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
}

// Per-skill lecture library for the standalone courses. Owning a course that
// includes the lecture's skill unlocks it; access is enforced server-side.
model CourseLecture {
  id            String   @id @default(uuid())
  skill         Skill
  title         String
  description   String?
  displayOrder  Int      @default(0)
  bunnyVideoId  String?
  videoUrl      String?
  durationMin   Int?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([skill, isPublished, displayOrder])
}

// Where a PortalResource shows: the Reading / Listening cheat-sheet pages, or the
// "must watch" intro video above the Reading Part C articles reader.
enum PortalResourcePlacement {
  READING_CHEATSHEET
  LISTENING_CHEATSHEET
  READING_ARTICLE_INTRO
  ONBOARDING_INTRO
}

enum PortalResourceKind {
  PDF
  VIDEO
}

// Premium portal resources rendered on the cheat-sheet pages and above the Part C
// articles reader. A PDF item uses `pdfUrl`; a VIDEO item uses `bunnyVideoId`
// (signed embed) or a plain `videoUrl`. Access is enforced server-side by skill
// ownership, mirroring CourseLecture.
model PortalResource {
  id           String                  @id @default(uuid())
  placement    PortalResourcePlacement
  kind         PortalResourceKind
  title        String
  description  String?
  displayOrder Int                     @default(0)
  pdfUrl       String?
  bunnyVideoId String?
  videoUrl     String?
  isPublished  Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([placement, isPublished, displayOrder])
}

// Unified per-user ownership. Additive: a user can hold many concurrently
// (e.g. Complete Course + a standalone course). Never collapsed to one.
model Entitlement {
  id             String            @id @default(uuid())
  userId         String
  productId      String?           // set for standalone-product entitlements
  planId         String?           // set for Complete Course (mirrors the active subscription's plan)
  entitlementKey String            // denormalized stable key (product.entitlementKey or "complete")
  source         EntitlementSource
  status         EntitlementStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?
  productPurchaseId String?
  grantedAt      DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  product        Product?          @relation(fields: [productId], references: [id])

  @@index([userId, status])
  @@index([entitlementKey])
}

model Test {
  id             String         @id @default(uuid())
  type           TestType
  title          String
  description    String?
  instructions           String?
  partASubInstructions   String?
  partBSubInstructions   String?
  partCSubInstructions   String?
  partABookletHtml       String?
  partBBookletHtml       String?
  partBExtractBooklets   Json?
  partAExtractQuestionHeadings Json?
  partAQuestionHeadingGroups Json?
  partCExtractQuestionHeadings Json?
  partCBookletHtml       String?
  partCExtractBooklets   Json?
  totalQuestions Int
  timerDuration  Int
  partATimer     Int?
  partBCTimer    Int?
  /// One-paste OET import document (canonical schema). When present, this test is
  /// rendered + scored from this JSON (official OET grading) instead of Question rows.
  contentJson          Json?
  contentSchemaVersion Int?
  audioAssetId         String?
  bookletAssetId       String?
  partBBookletAssetId  String?
  partCBookletAssetId  String?
  isPublished          Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  questions         Question[]
  listeningTracks   ListeningAudioTrack[]
  attempts          TestAttempt[]
  results           TestResult[]
  readingTasks              DailyTask[]  @relation("ReadingTaskTest")
  listeningTasks            DailyTask[]  @relation("ListeningTaskTest")
  pastPaperTasks            DailyTask[]  @relation("PastPaperTaskTest")
  pastPaperListeningBundles PastPaper[]  @relation("PastPaperListening")
  pastPaperReadingBundles   PastPaper[]  @relation("PastPaperReading")
  audioAsset           StorageObject? @relation("TestAudioAsset", fields: [audioAssetId], references: [id])
  bookletAsset         StorageObject? @relation("TestBookletAsset", fields: [bookletAssetId], references: [id])
  partBBookletAsset    StorageObject? @relation("TestPartBBookletAsset", fields: [partBBookletAssetId], references: [id])
  partCBookletAsset    StorageObject? @relation("TestPartCBookletAsset", fields: [partCBookletAssetId], references: [id])
}

/// Legacy per-extract tracks for Listening. New tests use `Test.audioAssetId` as one session audio file.
model ListeningAudioTrack {
  id        String   @id @default(uuid())
  testId    String
  sortOrder Int
  label     String?
  assetId   String
  createdAt DateTime @default(now())

  test  Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  asset StorageObject @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([testId, sortOrder])
  @@index([testId])
}

model Question {
  id             String          @id @default(uuid())
  testId         String
  sequence       Int
  part           QuestionPart
  extractId      String?
  type           QuestionType
  content        String
  options        Json?
  correctAnswer  String
  explanation    String?
  points         Int             @default(1)
  createdAt      DateTime        @default(now())

  test           Test            @relation(fields: [testId], references: [id])
  attemptAnswers AttemptAnswer[]

  @@index([testId])
  @@unique([testId, sequence])
}

model TestResult {
  id              String     @id @default(uuid())
  userId          String
  testId          String
  latestAttemptId String?
  score           Int
  partAScore      Int?
  partBScore      Int?
  partCScore      Int?
  bandLabel       BandLabel
  passProbability Float
  scaledScore     Int?       // official OET 0–500 (imported tests)
  oetGrade        OetGrade?  // official OET grade A–E (imported tests)
  completedAt     DateTime
  attemptsCount   Int        @default(1)
  createdAt       DateTime   @default(now())

  user            User       @relation(fields: [userId], references: [id])
  test            Test       @relation(fields: [testId], references: [id])

  @@index([userId])
  @@index([testId])
  @@unique([userId, testId])
}

/// A past paper bundles one Listening test and one Reading test for full-exam practice.
model PastPaper {
  id              String   @id @default(uuid())
  title           String
  description     String?
  listeningTestId String
  readingTestId   String
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listeningTest Test        @relation("PastPaperListening", fields: [listeningTestId], references: [id])
  readingTest   Test        @relation("PastPaperReading", fields: [readingTestId], references: [id])
  dailyTasks    DailyTask[] @relation("PastPaperAssignment")

  @@index([listeningTestId])
  @@index([readingTestId])
}

model DailyTask {
  id                      String         @id @default(uuid())
  dayNumber               Int            @unique
  title                   String
  summary                 String?
  lectureTitle            String
  lectureUrl              String
  lectureAssetId          String?
  lectureThumbnailAssetId String?
  lectureBunnyVideoId     String?
  articleTitle            String
  articleUrl              String
  articleContent            String?        @db.Text
  articleAssetId          String?
  articleThumbnailAssetId String?
  articleBunnyVideoId     String?
  articlePdfAssetId       String?
  assignedReadingTestId   String?
  assignedListeningTestId String?
  assignedPastPaperId     String?
  assignedPastPaperTestId String?
  pastPaperTitle          String?
  pastPaperUrl            String?
  pastPaperAssetId        String?
  cheatSheetAssetId       String?
  isPublished             Boolean        @default(true)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  assignedReadingTest     Test?          @relation("ReadingTaskTest", fields: [assignedReadingTestId], references: [id])
  assignedListeningTest   Test?          @relation("ListeningTaskTest", fields: [assignedListeningTestId], references: [id])
  assignedPastPaper       PastPaper?     @relation("PastPaperAssignment", fields: [assignedPastPaperId], references: [id])
  assignedPastPaperTest   Test?          @relation("PastPaperTaskTest", fields: [assignedPastPaperTestId], references: [id])
  lectureAsset            StorageObject? @relation("DailyTaskLectureAsset", fields: [lectureAssetId], references: [id])
  lectureThumbnailAsset   StorageObject? @relation("DailyTaskLectureThumbnailAsset", fields: [lectureThumbnailAssetId], references: [id])
  articleAsset            StorageObject? @relation("DailyTaskArticleAsset", fields: [articleAssetId], references: [id])
  articleThumbnailAsset   StorageObject? @relation("DailyTaskArticleThumbnailAsset", fields: [articleThumbnailAssetId], references: [id])
  articlePdfAsset         StorageObject? @relation("DailyTaskArticlePdfAsset", fields: [articlePdfAssetId], references: [id])
  pastPaperAsset          StorageObject? @relation("DailyTaskPastPaperAsset", fields: [pastPaperAssetId], references: [id])
  cheatSheetAsset         StorageObject? @relation("DailyTaskCheatSheetAsset", fields: [cheatSheetAssetId], references: [id])
}

model Blog {
  id           String         @id @default(uuid())
  title        String
  description  String         @db.Text
  content      String?        @db.Text
  blogType     BlogType       @default(READING)
  imageAssetId String?
  status       BlogStatus     @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status, publishedAt])
}

model Purchase {
  id              String         @id @default(uuid())
  userId          String
  planId          String
  amount          Decimal        @db.Decimal(10, 2)
  currency        String         @default("USD")
  status          PurchaseStatus @default(PENDING)
  provider        String?
  reference       String?
  checkoutSessionId String?      @unique
  activationToken String?        @unique
  activationUrl   String?
  retryCount      Int            @default(0)
  failureReason   String?
  receiptUrl      String?
  receiptData     Json?
  webhookEventId  String?
  webhookPayload  Json?
  webhookReceivedAt DateTime?
  completedAt     DateTime?
  emailSentAt     DateTime?
  /// True when the buyer upgraded from an active/trial STARTER plan (same subscription row rewritten).
  upgradedFromTrial Boolean      @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  plan            Plan           @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([upgradedFromTrial])
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entityType  String
  entityId    String?
  route       String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  actorUser   User?     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model OTPCode {
  id         String      @id @default(uuid())
  userId     String
  code       String
  purpose    OTPPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code, purpose])
}

model StorageObject {
  id             String      @id @default(uuid())
  kind           AssetKind
  bucket         String
  objectKey      String      @unique
  title          String
  contentType    String
  sizeBytes      Int
  uploadedById   String?
  createdAt      DateTime    @default(now())

  uploadedBy     User?       @relation(fields: [uploadedById], references: [id])
  testAudioFor          Test[] @relation("TestAudioAsset")
  testBookletFor        Test[] @relation("TestBookletAsset")
  testPartBBookletFor   Test[] @relation("TestPartBBookletAsset")
  testPartCBookletFor   Test[] @relation("TestPartCBookletAsset")
  listeningTrackUses ListeningAudioTrack[]
  lectureTasks       DailyTask[]              @relation("DailyTaskLectureAsset")
  lectureThumbnailTasks DailyTask[]           @relation("DailyTaskLectureThumbnailAsset")
  articleTasks   DailyTask[] @relation("DailyTaskArticleAsset")
  articleThumbnailTasks DailyTask[] @relation("DailyTaskArticleThumbnailAsset")
  articlePdfTasks DailyTask[] @relation("DailyTaskArticlePdfAsset")
  pastPaperTasks DailyTask[] @relation("DailyTaskPastPaperAsset")
  cheatSheetTasks DailyTask[] @relation("DailyTaskCheatSheetAsset")
  howToIntroductionVideo HowToIntroduction? @relation("HowToIntroductionVideoAsset")
  howToIntroductionThumbnail HowToIntroduction? @relation("HowToIntroductionThumbnailAsset")
  websiteHomeHeroVideo WebsiteHomeContent? @relation("WebsiteHomeHeroVideoAsset")
}

model WebsiteHomeContent {
  id             String         @id @default("default")
  heroVideoAssetId String?      @unique
  heroVideoAsset StorageObject? @relation("WebsiteHomeHeroVideoAsset", fields: [heroVideoAssetId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model HowToIntroduction {
  id               String         @id @default("default")
  title            String         @default("Introduction (How to use)")
  videoAssetId     String?        @unique
  videoAsset       StorageObject? @relation("HowToIntroductionVideoAsset", fields: [videoAssetId], references: [id], onDelete: SetNull)
  thumbnailAssetId String?        @unique
  thumbnailAsset   StorageObject? @relation("HowToIntroductionThumbnailAsset", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model TestAttempt {
  id                    String         @id @default(uuid())
  userId                String
  testId                String
  status                AttemptStatus  @default(IN_PROGRESS)
  section               AttemptSection
  startedAt             DateTime       @default(now())
  expiresAt             DateTime
  sectionExpiresAt      DateTime?
  submittedAt           DateTime?
  autoSubmittedAt       DateTime?
  currentQuestionIndex  Int            @default(0)
  questionCountAnswered Int            @default(0)
  timeRemainingSeconds  Int?
  audioPositionSeconds  Int            @default(0)
  audioUnlockedAt       DateTime?
  audioCompleted        Boolean        @default(false)
  currentListeningTrackIndex Int       @default(0)
  listeningFinalCountdownEndsAt DateTime?
  countdownStartedAt    DateTime?
  answersJson           Json?
  score                 Int?
  partAScore            Int?
  partBScore            Int?
  partCScore            Int?
  bandLabel             BandLabel?
  passProbability       Float?
  scaledScore           Int?           // official OET 0–500 (imported tests)
  oetGrade              OetGrade?      // official OET grade A–E (imported tests)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id])
  test                  Test           @relation(fields: [testId], references: [id])
  answers               AttemptAnswer[]

  @@index([userId])
  @@index([testId])
  @@index([status])
}

model AttemptAnswer {
  id         String      @id @default(uuid())
  attemptId  String
  questionId String
  response   String
  isCorrect  Boolean?
  answeredAt DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  attempt    TestAttempt @relation(fields: [attemptId], references: [id])
  question   Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ==================== COHORT LAYER ====================
enum CohortSessionSlot {
  LECTURE      // Class 1 — Daily Lecture  (DailyTask.lecture*)
  CORE_SKILLS  // Class 2 — Core Skills Session (DailyTask.article*)
}

enum CohortAttendance {
  UPCOMING
  ATTENDED
  LATE
  MISSED
  EXCUSED
}

enum CohortDayStatus {
  UPCOMING
  ACTIVE
  PARTIAL
  COMPLETED
  COMPLETED_LATE
  MISSED
}

model CohortSchedule {
  id            String   @id @default(uuid())
  userId        String   @unique
  country       String
  timezone      String   // IANA, e.g. Asia/Karachi — validated server-side
  class1Time    String   // "HH:mm" local time for Daily Lecture
  class2Time    String   // "HH:mm" local time for Core Skills Session
  startDate     DateTime // local date of programme Day 1 (stored midnight UTC of that date)
  totalDays     Int      @default(40)
  restWeekday   Int      @default(0) // 0=Sunday
  lockedAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  changes       CohortScheduleChange[]
}

model CohortScheduleChange {
  id          String   @id @default(uuid())
  scheduleId  String
  field       String   // class1Time | class2Time | timezone
  oldValue    String
  newValue    String
  changedAt   DateTime @default(now())

  schedule    CohortSchedule @relation(fields: [scheduleId], references: [id])
  @@index([scheduleId])
}

model CohortSessionRecord {
  id                 String            @id @default(uuid())
  userId             String
  dayNumber          Int               // FK-by-value to DailyTask.dayNumber
  slot               CohortSessionSlot
  scheduledAt        DateTime          // canonical UTC instant of session start
  attendance         CohortAttendance  @default(UPCOMING)
  firstJoinedAt      DateTime?
  lastActivityAt     DateTime?
  activeWatchSec     Int               @default(0) // during the live window
  recordingWatchSec  Int               @default(0) // catch-up viewing
  lastPositionSec    Int               @default(0)
  furthestPositionSec Int              @default(0)
  completedAt        DateTime?         // content completion (separate from attendance)
  reminderSentAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id])
  @@unique([userId, dayNumber, slot])
  @@index([userId, scheduledAt])
  @@index([scheduledAt]) // reminder job scan
}

model CohortDayProgress {
  id             String          @id @default(uuid())
  userId         String
  dayNumber      Int
  status         CohortDayStatus @default(UPCOMING)
  completionPct  Int             @default(0)
  completedAt    DateTime?
  completedLate  Boolean         @default(false)
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  @@unique([userId, dayNumber])
  @@index([userId, status])
}

model CohortNotificationLog {
  id                String    @id @default(uuid())
  userId            String
  type              String    // session_reminder | missed_session | pending_work | weekly_report | warning
  refKey            String    @unique // idempotency: e.g. "reminder:<sessionRecordId>"
  scheduledFor      DateTime?
  sentAt            DateTime?
  status            String    @default("pending") // pending | sent | failed
  providerMessageId String?
  error             String?
  retryCount        Int       @default(0)
  createdAt         DateTime  @default(now())

  @@index([userId, type])
  @@index([status, scheduledFor])
}

model CohortWarning {
  id             String    @id @default(uuid())
  userId         String
  type           String    // reminder | warning | strong_warning
  reason         String
  relatedDates   String    // e.g. "2026-07-17,2026-07-18,2026-07-19"
  issuedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  status         String    @default("open") // open | acknowledged | resolved

  user           User      @relation(fields: [userId], references: [id])
  @@index([userId, status])
}

model CohortWeeklyReport {
  id           String   @id @default(uuid())
  userId       String
  periodStart  DateTime // Monday 00:00 in student's timezone, stored UTC
  periodEnd    DateTime
  data         Json     // frozen snapshot — never recalculated
  emailedAt    DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])
  @@unique([userId, periodStart])
}

model CohortChatMessage {
  id          String            @id @default(uuid())
  userId      String
  dayNumber   Int               // FK-by-value to DailyTask.dayNumber — one thread per session
  slot        CohortSessionSlot
  authorName  String            // snapshot of display name at send time
  role        Role              @default(CANDIDATE) // drives instructor/admin badge styling
  text        String            @db.Text
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id])
  @@index([dayNumber, slot, createdAt])
  @@index([userId])
}

/// Core-skill drill library. Each drill is a self-contained interactive HTML
/// file (e.g. a scan/skim drill) uploaded in admin. A global "drill of the day"
/// per module rotates every 24h. `module` matches the portal skill-practice
/// keys: part-a-core | part-bc-core | spellings | part-c-podcasts.
model SkillDrill {
  id           String   @id @default(uuid())
  module       String
  title        String
  html         String   @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([module, isActive, displayOrder])
}

/// OET Listening Part A spelling bank. Each term is a medical word/phrase the
/// candidate hears (via TTS) and must spell. Powers the "Listening Spellings"
/// core-skill module. Seeded from the provided bank; admin-manageable.
model SpellingTerm {
  id         String   @id @default(uuid())
  term       String
  category   String
  hint       String   @default("")
  difficulty Int      @default(1)
  words      Int      @default(1)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category, isActive])
  @@index([isActive])
}

/// Daily-rotating listening podcast library for the Listening "Part C Podcasts"
/// core-skill surface. One published podcast is shown to every student per UTC
/// day (same rotation as SkillDrill). Audio is either an uploaded StorageObject
/// (audioAssetId, resolved to a signed URL) or a pasted audioUrl.
model ListeningPodcast {
  id           String   @id @default(uuid())
  kicker       String?
  title        String
  description  String?  @db.Text
  audioAssetId String?
  audioUrl     String?  @db.Text
  durationSec  Int?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

/// OET Writing course — a case-note task in a profession's library. Students
/// see only the library matching the profession they picked at sign-up.
model WritingCaseNote {
  id            String   @id @default(uuid())
  profession    String
  title         String
  scenario      String   @db.Text
  caseNotesHtml String   @db.Text
  wordGuidance  String?
  timeLimitMin  Int      @default(45)
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profession, isActive, displayOrder])
}

/// Per-profession Writing correction inbox (letters route here). profession="*"
/// is the global default used when a profession has no row.
model WritingSetting {
  id              String   @id @default(uuid())
  profession      String   @unique
  correctionEmail String
  updatedAt       DateTime @updatedAt
}

/// A submitted OET Writing letter — emailed to the correction inbox, numbered
/// per student (letterNumber) and tagged with the student's writingCode.
model WritingSubmission {
  id             String   @id @default(uuid())
  userId         String
  caseNoteId     String
  profession     String
  studentCode    String
  letterNumber   Int
  letterText     String   @db.Text
  wordCount      Int
  autoSubmitted  Boolean  @default(false)
  emailDelivered Boolean  @default(false)
  submittedAt    DateTime @default(now())

  @@index([userId, submittedAt])
  @@index([caseNoteId])
}

/// Generic per-(student, UTC day, activity) completion marker for the daily
/// accountability dashboard. `kind` = lecture | spelling | article | podcast.
/// (Tests are derived from TestAttempt.submittedAt; podcast also has its own
/// PodcastListen row for the player streak.)
model StudentActivity {
  id        String   @id @default(uuid())
  userId    String
  dayKey    Int
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, dayKey, kind])
  @@index([dayKey, kind])
  @@index([userId, dayKey])
}

/// One row per (student, UTC day) when the student finishes the day's podcast.
/// Powers the "listened today" tick, total-count and day-streak on the player.
model PodcastListen {
  id         String   @id @default(uuid())
  userId     String
  podcastId  String
  dayKey     Int
  listenedAt DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId])
}

/// Premium reading-article bank for the Reading Part B/C core-skill surface.
/// One published article is shown to every student per UTC day (global daily
/// rotation, same algorithm as SkillDrill). Structured content — rendered with
/// our premium serif typography; `bodyText` holds paragraphs separated by blank
/// lines (auto-numbered on render).
model ReadingArticle {
  id           String   @id @default(uuid())
  kicker       String?
  title        String
  standfirst   String?  @db.Text
  bodyText     String   @db.Text
  attribution  String?  @db.Text
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}
